# copy to .env — never commit .env
LGE_DSN=postgresql://postgres@127.0.0.1:54329/lge
LGE_OBJECT_STORE=.local/objects
# honest, contactable crawler identity — required before any live crawl
LGE_USER_AGENT=LegalSoftLeadEngine/0.1 (+https://legalsoft.com)

# --- the seams: one key per provider, one choice per interface -----------
# Every choice defaults to `auto`: the first provider whose key is present,
# else the free path. Set a name to force one (e.g. LGE_SEARCH_ENGINE=brave).

# Sheet reader (which column is which): llm | rules | auto
LGE_COLUMN_READER=auto
# LLM (sheet reader, site extraction P8/P9) via OpenRouter — inert when empty
OPENROUTER_API_KEY=

# Web search (LinkedIn profiles, emails in snippets, Google Business Profile):
# serper | brave | ddg | auto. DuckDuckGo is keyless and throttled — dev only.
LGE_SEARCH_ENGINE=auto
SERPER_API_KEY=
BRAVE_API_KEY=

# The Google Business Profile and its reviews (D-062), through a licensed
# API and never a scraped page: google_places | serper | none | auto.
# Google's own Places API gives the listing and five reviews in one call
# and is free for the first 1,000 lookups a month; Serper's key does the
# same job when this one is blank.
LGE_LISTINGS=auto
GOOGLE_PLACES_API_KEY=

# Addresses are found by our own scraping (D-050); no finder vendor is used.
# Verification is the one rented step: a verification-only service.
# LGE_EMAIL_VERIFIER: neverbounce | zerobounce | none | auto (first key found).
LGE_EMAIL_FINDER=none
LGE_EMAIL_VERIFIER=auto
NEVERBOUNCE_API_KEY=
ZEROBOUNCE_API_KEY=

# --- who may use the screens (D-067) ---------------------------------------
# Google sign-in is on once both are set (a Google Cloud OAuth client of type
# "Web application", with http://127.0.0.1:5000/api/auth/google/callback as
# an authorised redirect URI). Until then the engine answers its one local
# operator as it always has.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Admins the moment they sign in, comma-separated; they skip the form and
# cannot be demoted on the Users screen.
LGE_ADMIN_EMAILS=vishal.tiwari@legalsoft.com
# Only these domains may sign in (comma-separated; empty = any Google account).
LGE_ALLOWED_EMAIL_DOMAINS=legalsoft.com
# The screens' origin, for Google's redirect back.
LGE_PUBLIC_ORIGIN=http://127.0.0.1:5000
# Signs the sign-in-in-flight cookie; any long random string. Optional.
LGE_AUTH_SECRET=
