# copy to .env — never commit .env
LGE_DSN=postgresql://postgres@127.0.0.1:54329/lge
LGE_OBJECT_STORE=.local/objects
# honest, contactable crawler identity — required before any live crawl
LGE_USER_AGENT=LegalSoftLeadEngine/0.1 (+https://legalsoft.com)

# --- the seams: one key per provider, one choice per interface -----------
# Every choice defaults to `auto`: the first provider whose key is present,
# else the free path. Set a name to force one (e.g. LGE_SEARCH_ENGINE=brave).

# Sheet reader (which column is which): llm | rules | auto
LGE_COLUMN_READER=auto
# LLM (sheet reader, site extraction P8/P9) via OpenRouter — inert when empty
OPENROUTER_API_KEY=

# Web search (LinkedIn profiles, emails in snippets, Google Business Profile):
# serper | brave | ddg | auto. DuckDuckGo is keyless and throttled — dev only.
LGE_SEARCH_ENGINE=auto
SERPER_API_KEY=
BRAVE_API_KEY=

# Addresses are found by our own scraping (D-050); no finder vendor is used.
# Verification is the one rented step: a verification-only service.
# LGE_EMAIL_VERIFIER: neverbounce | zerobounce | none | auto (first key found).
LGE_EMAIL_FINDER=none
LGE_EMAIL_VERIFIER=auto
NEVERBOUNCE_API_KEY=
ZEROBOUNCE_API_KEY=
